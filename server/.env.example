ENV=prod
LOG_LEVEL=info
PORT=4000
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app

MONGODB_URL=mongodb+srv://username:password@cluster.example.mongodb.net
MONGO_DB=linklab

UPSTASH_REDIS_URL=rediss://default:password@region.upstash.io:6379
# Or use REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB instead.

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SQS_EMAIL_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/linklab-email
AWS_SQS_EMAIL_QUEUE_ARN=arn:aws:sqs:ap-south-1:123456789012:linklab-email

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=720
